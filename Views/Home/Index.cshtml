@{
    ViewData["Title"] = "Home";
}

<div class="home-hero">
    <h1>Welcome to The Central Library</h1>
    <p>A sanctuary of knowledge open to all members of the community.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-orange">Login</a>
</div>

<h3 class="section-title">Our Library at a Glance</h3>

<div class="row">
    <div class="col-md-3 col-sm-6">
        <div class="fact-card">
            <div class="fact-number">12,400+</div>
            <div class="fact-label">Books</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="fact-card">
            <div class="fact-number">3,200</div>
            <div class="fact-label">Members</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="fact-card">
            <div class="fact-number">840</div>
            <div class="fact-label">Loans This Month</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="fact-card">
            <div class="fact-number">1952</div>
            <div class="fact-label">Established</div>
        </div>
    </div>
</div>

<h3 class="section-title mt-5">Inside the Library</h3>

<div class="row">
    <div class="col-md-6">
        <img src='@Url.Content("~/images/img1.jpg")'           @* @Url.Content(path) returns absolute path with regard to project folder *@
             alt="Reading hall" class="gallery-img" />
    </div>
    <div class="col-md-6">
        <img src='@Url.Content("~/images/img2.jpg")'
             alt="Bookshelves" class="gallery-img" />
    </div>
</div>

<h3 class="section-title mt-5">About the Library</h3>

<div class="row">
    <div class="col-md-6">
        <h5>Opening Hours</h5>
        <table class="table table-sm">
            <tr><td>Monday &ndash; Friday</td><td>8:00 AM &ndash; 8:00 PM</td></tr>
            <tr><td>Saturday</td><td>9:00 AM &ndash; 6:00 PM</td></tr>
            <tr><td>Sunday</td><td>10:00 AM &ndash; 4:00 PM</td></tr>
            <tr><td>Public Holidays</td><td>Closed</td></tr>
        </table>
    </div>
    <div class="col-md-6">
        <h5>Membership</h5>
        <p>
            Members may borrow up to <strong>3 books</strong> at a time for a period of
            <strong>14 days</strong>. A fine of &#8377;2 per day is charged on overdue returns.
            New membership is open to all enrolled students and faculty.
        </p>
    </div>
</div>
