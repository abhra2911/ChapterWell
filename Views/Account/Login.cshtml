@model Lib_Mgmt.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-wrap">
    <div class="login-box">
        <div class="login-badge"><i class="bi bi-book-half"></i></div>
        <h2>Welcome Back</h2>
        <p class="login-sub">Sign in to The Central Library portal</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username or Email</label>
                <input asp-for="Username" class="form-control" placeholder="Enter your username or email" required autofocus />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </button>
        </form>

        <div class="login-hint">
            <i class="bi bi-info-circle me-1"></i>
            Demo logins — librarian <strong>lib</strong> / member <strong>mem</strong>, password <strong>123</strong>.
        </div>
    </div>
</div>
