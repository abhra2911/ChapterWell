@model Lib_Mgmt.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-wrap">
    <h2>Login</h2>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <p class="text-danger mt-3" style="font-size:.875rem;">@ViewBag.Error</p>
    }
</div>
