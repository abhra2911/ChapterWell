@model Lib_Mgmt.Models.MemberDashboardViewModel

<h2>Welcome back, @Model.MemberName</h2>
<p class="subtitle">Your borrowing overview and most popular books</p>
<hr />

<div class="row">
    <div class="col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="stat-label">Currently Borrowed</div>
            <div class="stat-value">@Model.CurrentlyBorrowed</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="stat-card danger">
            <div class="stat-label">Overdue</div>
            <div class="stat-value">@Model.OverdueCount</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="stat-card warning">
            <div class="stat-label">Fine Due</div>
            <div class="stat-value">&#8377;@Model.FineDue</div>
        </div>
    </div>
</div>

<div class="carousel-section">
    <div class="carousel-head">
        <h4 class="mt-4 mb-3" style="color: var(--accent-text);">Top 10 Most Borrowed Books</h4>
        <div class="carousel-buttons">
            <button type="button" class="carousel-btn prev" aria-label="Scroll to previous books">&#10094;</button>
            <button type="button" class="carousel-btn next" aria-label="Scroll to more books">&#10095;</button>
        </div>
    </div>
    <div class="book-carousel">
        @foreach (var book in Model.TopBooks)
        {
            var cover = string.IsNullOrEmpty(book.CoverImage) ? "/images/placeholder-cover.svg" : book.CoverImage; 
            <article class="book-card">
                <img class="cover" src="@cover" alt="Cover of @book.Title" />
                <div class="body">
                    <div class="title">@book.Title</div>
                    <div class="author">@book.Author</div>
                    @if (book.Available)
                    {
                        <span class="avail yes">Available</span>
                    }
                    else
                    {
                        <span class="avail no">Unavailable</span>
                    }
                </div>
            </article>
        }
    </div>
</div>

<h4 class="mt-4 mb-3" style="color: var(--accent-text);">My Active Loans</h4>
<div class="table-responsive">
    <table class="table table-striped table-hover bg-white">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Borrowed On</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Fine</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ActiveLoans.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">No active loans.</td></tr>
            }
            else
            {
                @foreach (var loan in Model.ActiveLoans)
                {
                    <tr>
                        <td>@loan.Title</td>
                        <td>@loan.BorrowedOn.ToString("dd MMM yyyy")</td>
                        <td>@loan.DueDate.ToString("dd MMM yyyy")</td>
                        @if (loan.Status == "Overdue")
                        {
                            <td class="text-danger">Overdue</td>
                            <td class="text-danger">&#8377;@loan.Fine</td>
                        }
                        else
                        {
                            <td class="text-success">On time</td>
                            <td>&#8377;@loan.Fine</td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
