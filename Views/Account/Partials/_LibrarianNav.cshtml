@{
    var active = ViewData["ActiveSection"] as string ?? "lib-dashboard";
}
<nav class="portal-nav">
    <span class="brand"><i class="bi bi-book-half"></i>The Central Library</span>
    <button type="button" class="portal-nav-toggler" data-bs-toggle="collapse" data-bs-target="#portalNavCollapse" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list"></i>
    </button>
    <div class="portal-nav-collapse collapse" id="portalNavCollapse">
        <a asp-controller="Account" asp-action="LibrarianDashboard"
           class="@(active == "lib-dashboard" ? "active" : "")">Dashboard</a>
        <a asp-controller="Account" asp-action="LibrarianBooks"
           class="@(active == "books" ? "active" : "")">Books</a>
        <a asp-controller="Account" asp-action="LibrarianBorrowings"
           class="@(active == "borrowings" ? "active" : "")">Borrowings</a>
        <a asp-controller="Account" asp-action="LibrarianMembers"
           class="@(active == "members" ? "active" : "")">Members</a>
        <a asp-controller="Account" asp-action="LibrarianAccount"
           class="@(active == "account" ? "active" : "")">Account</a>
        <span class="spacer"></span>
        <span class="dark-btn-wrap">
            <button type="button" class="dark-mode-btn" onclick="toggleTheme()">
                <i class="bi bi-moon-stars"></i><span>Dark Mode</span>
            </button>
        </span>
        <a asp-controller="Account" asp-action="Logout" class="nav-logout" style="color: var(--brand-danger)">  @* CSS VAR DANGER *@
            <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
    </div>
</nav>
