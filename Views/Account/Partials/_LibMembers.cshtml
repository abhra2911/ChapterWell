@model Lib_Mgmt.Models.LibrarianMembersViewModel
@{
    var rows      = Model?.Borrowings ?? new List<Lib_Mgmt.Models.MemberBorrowingRow>();
    var reopen    = TempData["ReopenModal"] as string;
    var formError = TempData["FormError"] as string;
}

<h2>Members</h2>
<p class="subtitle">Current borrowings of all members</p>
<hr />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#addMemberModal">
        <i class="bi bi-plus-lg me-1"></i>Add Member
    </button>
    <span class="result-count" data-filter-count>@rows.Count results</span>
</div>

<div data-filter-root>
    <div class="toolbar">
        <div class="search-field">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" data-filter-search
                   placeholder="Search by member or book..." aria-label="Search members" />
        </div>
    </div>

    <div class="data-table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Book Borrowed</th>
                    <th>Borrowed On</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr data-filter-item
                        data-title="@r.BookTitle" data-author="@r.MemberName" data-genre="">
                        <td class="fw-semibold">@r.MemberName</td>
                        <td>@r.BookTitle</td>
                        <td>@r.BorrowedOn.ToString("dd MMM yyyy")</td>
                        <td>@r.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (r.IsOverdue)
                            {
                                <span class="avail-pill no">Overdue</span>
                            }
                            else
                            {
                                <span class="avail-pill yes">On time</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal" data-bs-target="#memberDetailModal"
                                    data-member="@r.MemberName" data-memberid="@r.MemberId"
                                    data-email="@r.Email" data-book="@r.BookTitle"
                                    data-borrowed="@r.BorrowedOn.ToString("dd MMM yyyy")"
                                    data-due="@r.DueDate.ToString("dd MMM yyyy")"
                                    data-status="@(r.IsOverdue ? "Overdue" : "On time")"
                                    data-overdue="@r.DaysOverdue days"
                                    data-fine="&#8377;@r.Fine">
                                <i class="bi bi-eye me-1"></i>View
                            </button>
                        </td>
                    </tr>
                }
                <tr data-filter-empty style="display:none">
                    <td colspan="6">
                        <div class="empty-state border-0">
                            <i class="bi bi-search"></i>
                            No members match your search.
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<!--   Member borrowing detail modal (read-only, filled from data-*)   -->
<div class="modal fade" id="memberDetailModal" tabindex="-1" data-fillable
     aria-labelledby="memberDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="memberDetailModalLabel">
                    <i class="bi bi-person-vcard"></i>Borrowing Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Member</div>
                        <div class="detail-value" data-field="member"></div>
                    </div>
                    <div>
                        <div class="detail-label">Member ID</div>
                        <div class="detail-value" data-field="memberid"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Email</div>
                        <div class="detail-value" data-field="email"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Book Borrowed</div>
                        <div class="detail-value" data-field="book"></div>
                    </div>
                    <div>
                        <div class="detail-label">Borrowed On</div>
                        <div class="detail-value" data-field="borrowed"></div>
                    </div>
                    <div>
                        <div class="detail-label">Due Date</div>
                        <div class="detail-value" data-field="due"></div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-value" data-field="status"></div>
                    </div>
                    <div>
                        <div class="detail-label">Days Overdue</div>
                        <div class="detail-value" data-field="overdue"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Fine Due</div>
                        <div class="detail-value" data-field="fine"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!--   Add Member modal   -->
<div class="modal fade" id="addMemberModal" tabindex="-1"
     aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-controller="Account" asp-action="AddMember" method="post" autocomplete="off">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addMemberModalLabel">
                        <i class="bi bi-person-plus"></i>Add a New Member
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="modal-error" hidden="@(reopen == "addMemberModal" ? null : "hidden")">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="modal-error-text">@(reopen == "addMemberModal" ? formError : null)</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label for="mem-fullname" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="mem-fullname" data-label="Full Name"
                                   name="FullName" required maxlength="150" />
                        </div>
                        <div class="col-md-5">
                            <label for="mem-username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="mem-username" data-label="Username"
                                   name="Username" required minlength="3" maxlength="50"
                                   pattern="[A-Za-z0-9_.\-]+" placeholder="e.g. priya.s" autocomplete="off" />
                        </div>
                        <div class="col-md-7">
                            <label for="mem-email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="mem-email" data-label="Email"
                                   name="Email" required maxlength="150" />
                        </div>
                        <div class="col-md-5">
                            <label for="mem-phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="mem-phone" data-label="Phone"
                                   name="Phone" maxlength="20" placeholder="optional" />
                        </div>
                        <div class="col-md-6">
                            <label for="mem-password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="mem-password" data-label="Password"
                                   name="Password" required minlength="6" maxlength="100"
                                   autocomplete="new-password" />
                        </div>
                        <div class="col-md-6">
                            <label for="mem-confirm" class="form-label">Confirm Password</label>
                            <input type="password" class="form-control" id="mem-confirm" data-label="Confirm Password"
                                   name="ConfirmPassword" required minlength="6" maxlength="100"
                                   autocomplete="new-password" />
                        </div>
                        <div class="col-12">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                A member code (e.g. <code>MEM-0007</code>) will be assigned automatically.
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Member</button>
                </div>
            </div>
        </form>
    </div>
</div>
