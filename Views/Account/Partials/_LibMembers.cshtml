@model Lib_Mgmt.Models.LibrarianMembersViewModel
@{
    var rows = Model?.Borrowings ?? new List<Lib_Mgmt.Models.MemberBorrowingRow>();
}

<h2>Members</h2>
<p class="subtitle">Current borrowings of all members</p>
<hr />

<div class="d-flex justify-content-end mb-2">
    <span class="result-count" data-filter-count>@rows.Count results</span>
</div>

<div data-filter-root>
    <div class="toolbar">
        <div class="search-field">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" data-filter-search
                   placeholder="Search by member or book..." aria-label="Search members" />
        </div>
    </div>

    <div class="data-table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Book Borrowed</th>
                    <th>Borrowed On</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr data-filter-item
                        data-title="@r.BookTitle" data-author="@r.MemberName" data-genre="">
                        <td class="fw-semibold">@r.MemberName</td>
                        <td>@r.BookTitle</td>
                        <td>@r.BorrowedOn.ToString("dd MMM yyyy")</td>
                        <td>@r.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (r.IsOverdue)
                            {
                                <span class="avail-pill no">Overdue</span>
                            }
                            else
                            {
                                <span class="avail-pill yes">On time</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal" data-bs-target="#memberDetailModal"
                                    data-member="@r.MemberName" data-memberid="@r.MemberId"
                                    data-email="@r.Email" data-book="@r.BookTitle"
                                    data-borrowed="@r.BorrowedOn.ToString("dd MMM yyyy")"
                                    data-due="@r.DueDate.ToString("dd MMM yyyy")"
                                    data-status="@(r.IsOverdue ? "Overdue" : "On time")"
                                    data-overdue="@r.DaysOverdue days"
                                    data-fine="&#8377;@r.Fine">
                                <i class="bi bi-eye me-1"></i>View
                            </button>
                        </td>
                    </tr>
                }
                <tr data-filter-empty style="display:none">
                    <td colspan="6">
                        <div class="empty-state border-0">
                            <i class="bi bi-search"></i>
                            No members match your search.
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<!--   Member borrowing detail modal (read-only, filled from data-*)   -->
<div class="modal fade" id="memberDetailModal" tabindex="-1" data-fillable
     aria-labelledby="memberDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="memberDetailModalLabel">
                    <i class="bi bi-person-vcard"></i>Borrowing Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Member</div>
                        <div class="detail-value" data-field="member"></div>
                    </div>
                    <div>
                        <div class="detail-label">Member ID</div>
                        <div class="detail-value" data-field="memberid"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Email</div>
                        <div class="detail-value" data-field="email"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Book Borrowed</div>
                        <div class="detail-value" data-field="book"></div>
                    </div>
                    <div>
                        <div class="detail-label">Borrowed On</div>
                        <div class="detail-value" data-field="borrowed"></div>
                    </div>
                    <div>
                        <div class="detail-label">Due Date</div>
                        <div class="detail-value" data-field="due"></div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-value" data-field="status"></div>
                    </div>
                    <div>
                        <div class="detail-label">Days Overdue</div>
                        <div class="detail-value" data-field="overdue"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Fine Due</div>
                        <div class="detail-value" data-field="fine"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
