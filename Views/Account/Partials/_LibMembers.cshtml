@model Lib_Mgmt.Models.LibrarianMembersViewModel
@{
    var rows      = Model?.Members ?? new List<Lib_Mgmt.Models.RegisteredMemberRow>();
    var reopen    = TempData["ReopenModal"] as string;
    var formError = TempData["FormError"] as string;
}

<h2>Members</h2>
<p class="subtitle">All registered members</p>
<hr />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#addMemberModal">
        <i class="bi bi-plus-lg me-1"></i>Add Member
    </button>
    <span class="result-count" data-filter-count>@rows.Count results</span>
</div>

<div data-filter-root>
    <div class="toolbar">
        <div class="search-field">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" data-filter-search
                   placeholder="Search by name, code, or email..." aria-label="Search members" />
        </div>
    </div>

    <div class="data-table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Code</th>
                    <th>Email</th>
                    <th>Joined</th>
                    <th>Loans</th>
                    <th>Unpaid Fines</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr data-filter-item
                        data-title="@r.FullName" data-author="@r.MemberCode" data-genre="@r.Email">
                        <td class="fw-semibold">@r.FullName</td>
                        <td><code>@r.MemberCode</code></td>
                        <td>@r.Email</td>
                        <td>@r.JoinedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (r.ActiveLoans > 0)
                            {
                                <span class="badge bg-info text-dark">@r.ActiveLoans</span>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>
                        <td>
                            @if (r.UnpaidFines > 0)
                            {
                                <span class="text-danger fw-semibold">&#8377;@r.UnpaidFines</span>
                            }
                            else
                            {
                                <span class="text-muted">&#8377;0</span>
                            }
                        </td>
                        <td>
                            @if (r.IsActive)
                            {
                                <span class="avail-pill yes">Active</span>
                            }
                            else
                            {
                                <span class="avail-pill no">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-icon"
                                    title="View" data-bs-toggle="modal" data-bs-target="#memberDetailModal"
                                    data-name="@r.FullName" data-code="@r.MemberCode"
                                    data-email="@r.Email" data-phone="@r.Phone"
                                    data-joined="@r.JoinedDate.ToString("dd MMM yyyy")"
                                    data-loans="@r.ActiveLoans"
                                    data-fines="&#8377;@r.UnpaidFines"
                                    data-status="@(r.IsActive ? "Active" : "Inactive")">
                                <i class="bi bi-eye"></i>
                            </button>
                            <form asp-controller="Account" asp-action="DeleteMember" method="post"
                                  class="d-inline" onsubmit="return confirm('Delete @r.FullName? This cannot be undone.');">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="name" value="@r.FullName" />
                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="Delete member">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                <tr data-filter-empty style="display:none">
                    <td colspan="8">
                        <div class="empty-state border-0">
                            <i class="bi bi-search"></i>
                            No members match your search.
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<!--   Member detail modal (read-only, filled from data-*)   -->
<div class="modal fade" id="memberDetailModal" tabindex="-1" data-fillable
     aria-labelledby="memberDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="memberDetailModalLabel">
                    <i class="bi bi-person-vcard"></i>Member Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Name</div>
                        <div class="detail-value" data-field="name"></div>
                    </div>
                    <div>
                        <div class="detail-label">Member Code</div>
                        <div class="detail-value" data-field="code"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Email</div>
                        <div class="detail-value" data-field="email"></div>
                    </div>
                    <div>
                        <div class="detail-label">Phone</div>
                        <div class="detail-value" data-field="phone"></div>
                    </div>
                    <div>
                        <div class="detail-label">Joined</div>
                        <div class="detail-value" data-field="joined"></div>
                    </div>
                    <div>
                        <div class="detail-label">Active Loans</div>
                        <div class="detail-value" data-field="loans"></div>
                    </div>
                    <div>
                        <div class="detail-label">Unpaid Fines</div>
                        <div class="detail-value" data-field="fines"></div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="detail-label">Status</div>
                        <div class="detail-value" data-field="status"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!--   Add Member modal   -->
<div class="modal fade" id="addMemberModal" tabindex="-1"
     aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-controller="Account" asp-action="AddMember" method="post" autocomplete="off">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addMemberModalLabel">
                        <i class="bi bi-person-plus"></i>Add a New Member
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="modal-error" hidden="@(reopen == "addMemberModal" ? null : "hidden")">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="modal-error-text">@(reopen == "addMemberModal" ? formError : null)</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label for="mem-fullname" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="mem-fullname" data-label="Full Name"
                                   name="FullName" required maxlength="150" />
                        </div>
                        <div class="col-md-5">
                            <label for="mem-username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="mem-username" data-label="Username"
                                   name="Username" required minlength="3" maxlength="50"
                                   pattern="[A-Za-z0-9_.\-]+" placeholder="e.g. priya.s" autocomplete="off" />
                        </div>
                        <div class="col-md-7">
                            <label for="mem-email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="mem-email" data-label="Email"
                                   name="Email" required maxlength="150" />
                        </div>
                        <div class="col-md-5">
                            <label for="mem-phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="mem-phone" data-label="Phone"
                                   name="Phone" maxlength="20" placeholder="optional" />
                        </div>
                        <div class="col-md-6">
                            <label for="mem-password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="mem-password" data-label="Password"
                                   name="Password" required minlength="6" maxlength="100"
                                   autocomplete="new-password" />
                        </div>
                        <div class="col-md-6">
                            <label for="mem-confirm" class="form-label">Confirm Password</label>
                            <input type="password" class="form-control" id="mem-confirm" data-label="Confirm Password"
                                   name="ConfirmPassword" required minlength="6" maxlength="100"
                                   autocomplete="new-password" />
                        </div>
                        <div class="col-12">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                A member code (e.g. <code>MEM-0007</code>) will be assigned automatically.
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Member</button>
                </div>
            </div>
        </form>
    </div>
</div>
