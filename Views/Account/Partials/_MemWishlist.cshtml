@model Lib_Mgmt.Models.MemberWishlistViewModel
@{
    var reopen    = TempData["ReopenModal"] as string;
    var formError = TempData["FormError"] as string;
    var items     = Model?.Items ?? new List<Lib_Mgmt.Models.WishlistItem>();
    var addable   = Model?.AddableBooks ?? new List<Lib_Mgmt.Models.CatalogBook>();
}

<h2>Wishlist</h2>
<p class="subtitle">Books you've saved to borrow later</p>
<hr />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#addWishlistModal">
        <i class="bi bi-heart me-1"></i>Add to Wishlist
    </button>
    <span class="result-count" data-filter-count>@items.Count saved</span>
</div>

<div data-filter-root>
    <div class="toolbar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-7">
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control" data-filter-search
                           placeholder="Search your wishlist..." aria-label="Search wishlist" />
                </div>
            </div>
            <div class="col-lg-5">
                <div class="filter-chips justify-content-lg-end">
                    <span class="chip active" data-filter-avail="all">All</span>
                    <span class="chip" data-filter-avail="available">
                        <i class="bi bi-check-circle me-1"></i>Available now
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (items.Count == 0)
    {
        <div class="empty-state mt-2">
            <i class="bi bi-heart"></i>
            Your wishlist is empty. Use <strong>Add to Wishlist</strong> to save books you want to read.
        </div>
    }
    else
    {
        <div class="book-grid">
            @foreach (var w in items)
            {
                var cover = string.IsNullOrEmpty(w.CoverImage) ? "/images/placeholder-cover.svg" : w.CoverImage;
                <div class="book-card wish-card" data-filter-item
                     data-title="@w.Title" data-author="@w.Author" data-genre="@w.Genre"
                     data-available="@(w.Available ? "true" : "false")">
                    <div class="cover-wrap">
                        <img class="cover" src="@cover" alt="Cover of @w.Title" />
                    </div>
                    <div class="body">
                        <div class="title">@w.Title</div>
                        <div class="author">@w.Author</div>
                        <div class="meta-row">
                            <span class="genre-badge @Lib_Mgmt.Models.GenreBadge.CssClass(w.Genre)">@w.Genre</span>
                            @if (w.Available)
                            {
                                <span class="avail-pill yes">Available</span>
                            }
                            else
                            {
                                <span class="avail-pill no">Out</span>
                            }
                        </div>
                        <div class="wish-added">
                            <i class="bi bi-bookmark-star me-1"></i>Saved @w.AddedOn.ToString("dd MMM yyyy")
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger wish-remove"
                                data-bs-toggle="modal" data-bs-target="#removeWishModal"
                                data-id="@w.Id" data-title="@w.Title">
                            <i class="bi bi-trash me-1"></i>Remove
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="empty-state mt-3" data-filter-empty style="display:none">
            <i class="bi bi-journal-x"></i>
            No saved books match your filters.
        </div>
    }
</div>


<!--   Add to Wishlist modal   -->
<div class="modal fade" id="addWishlistModal" tabindex="-1"
     aria-labelledby="addWishlistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Account" asp-action="AddToWishlist" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addWishlistModalLabel">
                        <i class="bi bi-heart"></i>Add to Wishlist
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="modal-error" hidden="@(reopen == "addWishlistModal" ? null : "hidden")">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="modal-error-text">@(reopen == "addWishlistModal" ? formError : null)</span>
                    </div>

                    <div class="mb-3">
                        <label for="wish-book" class="form-label">Book</label>
                        <select class="form-select" id="wish-book" data-label="Book" name="bookId" required>
                            <option value="">Choose a book…</option>
                            @foreach (var b in addable)
                            {
                                <option value="@b.Id">@b.Title — @b.Author</option>
                            }
                        </select>
                        <div class="form-text">Only books not already on your wishlist are shown.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </div>
        </form>
    </div>
</div>


<!--   Remove from Wishlist confirm modal (filled from data-*)   -->
<div class="modal fade" id="removeWishModal" tabindex="-1" data-fillable
     aria-labelledby="removeWishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Account" asp-action="RemoveFromWishlist" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="removeWishModalLabel">
                        <i class="bi bi-trash"></i>Remove from Wishlist
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" data-field="id" />
                    <input type="hidden" name="title" data-field="title" />
                    <p class="mb-0">
                        Remove <strong data-field="title"></strong> from your wishlist?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Remove
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(reopen))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('@reopen');
            if (el) new bootstrap.Modal(el).show();
        });
    </script>
}
