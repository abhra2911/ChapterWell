@{
    var active = ViewData["ActiveSection"] as string ?? "dashboard";
}
<nav class="portal-nav">
    <span class="brand"><i class="bi bi-book-half"></i>The Central Library</span>
    <button type="button" class="portal-nav-toggler" data-bs-toggle="collapse" data-bs-target="#portalNavCollapse" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list"></i>
    </button>
    <div class="portal-nav-collapse collapse" id="portalNavCollapse">
        <a asp-controller="Account" asp-action="MemberDashboard"
           class="@(active == "dashboard" ? "active" : "")">Dashboard</a>
        <a asp-controller="Account" asp-action="MemberBooks"
           class="@(active == "books" ? "active" : "")">Books</a>
        <a asp-controller="Account" asp-action="MemberLoans"
           class="@(active == "loans" ? "active" : "")">Loans</a>
        <a asp-controller="Account" asp-action="MemberWishlist"
           class="@(active == "wishlist" ? "active" : "")">Wishlist</a>
        <a asp-controller="Account" asp-action="MemberReservations"
           class="@(active == "reservations" ? "active" : "")">Reservations</a>
        <a asp-controller="Account" asp-action="MemberAccount"
           class="@(active == "account" ? "active" : "")">Account</a>
        <span class="spacer"></span>
        <span class="dark-btn-wrap">
            <button type="button" class="dark-mode-btn" onclick="toggleTheme()">
                <i class="bi bi-moon-stars"></i><span>Dark Mode</span>
            </button>
        </span>
        <a asp-controller="Account" asp-action="Logout" class="nav-logout">  @* CSS VAR DANGER *@
            <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
    </div>
</nav>