@model Lib_Mgmt.Models.MemberLoansViewModel
@{
    var active  = Model?.Active  ?? new List<Lib_Mgmt.Models.DetailedLoan>();
    var history = Model?.History ?? new List<Lib_Mgmt.Models.LoanHistoryRow>();
    var fines   = (Model?.Fines  ?? new List<Lib_Mgmt.Models.FineRecord>())
                    .OrderByDescending(f => !f.IsPaid)    // outstanding first
                    .ThenByDescending(f => f.IssuedOn)
                    .ToList();
}

<h2>Loans</h2>
<p class="subtitle">Your current borrowings, full borrowing history, and any fines</p>
<hr />


<!-- ===========================================================
     Currently Borrowed
     =========================================================== -->
<h4 class="portal-section-title"><i class="bi bi-bookmark-check"></i>Currently Borrowed</h4>
<div class="data-table-wrap">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Borrowed On</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Fine</th>
            </tr>
        </thead>
        <tbody>
            @if (active.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">You have no active loans right now.</td></tr>
            }
            else
            {
                @foreach (var l in active)
                {
                    <tr>
                        <td class="fw-semibold">@l.Title</td>
                        <td>@l.Author</td>
                        <td>@l.BorrowedOn.ToString("dd MMM yyyy")</td>
                        <td>
                            @l.DueDate.ToString("dd MMM yyyy")
                            @if (!l.IsOverdue)
                            {
                                <div class="text-secondary small">in @l.DaysLeft day@(l.DaysLeft == 1 ? "" : "s")</div>
                            }
                        </td>
                        <td>
                            @if (l.Status == "Overdue")
                            {
                                <span class="avail-pill no">@l.DaysOverdue d overdue</span>
                            }
                            else if (l.Status == "Due soon")
                            {
                                <span class="avail-pill soon">Due soon</span>
                            }
                            else
                            {
                                <span class="avail-pill yes">On time</span>
                            }
                        </td>
                        <td class="@(l.IsOverdue ? "text-danger fw-semibold" : "")">&#8377;@l.Fine</td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>


<!-- ===========================================================
     Borrowing History
     =========================================================== -->
<h4 class="portal-section-title"><i class="bi bi-clock-history"></i>Borrowing History</h4>
<div data-filter-root>
    <div class="toolbar">
        <div class="search-field">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" data-filter-search
                   placeholder="Search history by title or author..." aria-label="Search history" />
        </div>
    </div>

    <div class="data-table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Borrowed On</th>
                    <th>Returned On</th>
                    <th>Outcome</th>
                    <th>Fine Paid</th>
                </tr>
            </thead>
            <tbody>
                @if (history.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No past borrowings yet.</td></tr>
                }
                else
                {
                    @foreach (var h in history)
                    {
                        <tr data-filter-item data-title="@h.Title" data-author="@h.Author" data-genre="">
                            <td class="fw-semibold">@h.Title</td>
                            <td>@h.Author</td>
                            <td>@h.BorrowedOn.ToString("dd MMM yyyy")</td>
                            <td>@h.ReturnedOn.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (h.WasLate)
                                {
                                    <span class="avail-pill soon">Returned late</span>
                                }
                                else
                                {
                                    <span class="avail-pill yes">On time</span>
                                }
                            </td>
                            <td>@(h.FinePaid > 0 ? "₹" + h.FinePaid.ToString() : "—")</td>
                        </tr>
                    }
                    <tr data-filter-empty style="display:none">
                        <td colspan="6">
                            <div class="empty-state border-0">
                                <i class="bi bi-search"></i>
                                No history entries match your search.
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- ===========================================================
     Fines (folded in from the old Fines tab)
     =========================================================== -->
<h4 class="portal-section-title"><i class="bi bi-cash-coin"></i>Fines</h4>

<div class="row">
    <div class="col-md-4 col-sm-6">
        <div class="stat-card danger">
            <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
            <div class="stat-body">
                <div class="stat-label">Outstanding</div>
                <div class="stat-value">&#8377;@Model.TotalOutstanding</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="stat-card warning">
            <div class="stat-icon"><i class="bi bi-receipt"></i></div>
            <div class="stat-body">
                <div class="stat-label">Unpaid Fines</div>
                <div class="stat-value">@Model.OutstandingCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="stat-card success">
            <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-body">
                <div class="stat-label">Paid to Date</div>
                <div class="stat-value">&#8377;@Model.TotalPaid</div>
            </div>
        </div>
    </div>
</div>

@if (Model.HasOutstanding)
{
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#payAllModal">
            <i class="bi bi-cash-stack me-1"></i>Pay All (&#8377;@Model.TotalOutstanding)
        </button>
    </div>
}

<div class="data-table-wrap">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Book</th>
                <th>Reason</th>
                <th>Issued On</th>
                <th>Amount</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (fines.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">You have no fines. Nicely done!</td></tr>
            }
            else
            {
                @foreach (var f in fines)
                {
                    <tr>
                        <td class="fw-semibold">@f.BookTitle</td>
                        <td>@f.Reason</td>
                        <td>@f.IssuedOn.ToString("dd MMM yyyy")</td>
                        <td class="@(f.IsPaid ? "" : "text-danger fw-semibold")">&#8377;@f.Amount</td>
                        <td>
                            @if (f.IsPaid)
                            {
                                <span class="avail-pill yes">Paid @f.PaidOn.Value.ToString("dd MMM yyyy")</span>
                            }
                            else
                            {
                                <span class="avail-pill no">Outstanding</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!f.IsPaid)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#payFineModal"
                                        data-id="@f.Id" data-book="@f.BookTitle" data-amount="&#8377;@f.Amount">
                                    <i class="bi bi-cash me-1"></i>Pay
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


<!-- ===========================================================
     Modals
     =========================================================== -->



<!--   Pay single fine confirm   -->
<div class="modal fade" id="payFineModal" tabindex="-1" data-fillable
     aria-labelledby="payFineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Account" asp-action="PayFine" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="payFineModalLabel">
                        <i class="bi bi-cash"></i>Pay Fine
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" data-field="id" />
                    <input type="hidden" name="book" data-field="book" />
                    <p class="mb-0">
                        Pay the fine of <strong data-field="amount"></strong> for
                        <strong data-field="book"></strong>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Confirm Payment
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>


<!--   Pay all fines confirm   -->
<div class="modal fade" id="payAllModal" tabindex="-1"
     aria-labelledby="payAllModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Account" asp-action="PayAllFines" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="payAllModalLabel">
                        <i class="bi bi-cash-stack"></i>Pay All Fines
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Settle all outstanding fines totalling
                        <strong>&#8377;@Model.TotalOutstanding</strong>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Pay &#8377;@Model.TotalOutstanding
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
