@{
    var reopen = TempData["ReopenModal"] as string;
}

<h2>Books</h2>
<p class="subtitle">Browse and manage the catalog</p>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["FormError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["FormError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3">
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#addBookModal">
        Add Book
    </button>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-md-10">
        <input type="text" class="form-control" placeholder="Search by title, author, or genre..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-striped columns table-hover bg-white ">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Quantity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            <tr>
                <td>Clean Code</td>
                <td>Robert Martin</td>
                <td>Programming</td>
                <td>12</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary">Edit</button>
                    <button type="button" class="btn btn-sm btn-danger">Delete</button>
                </td>
            </tr>
            <tr>
                <td>The Pragmatic Programmer</td>
                <td>Hunt &amp; Thomas</td>
                <td>Programming</td>
                <td>0</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary">Edit</button>
                    <button type="button" class="btn btn-sm btn-danger">Delete</button>
                </td>
            </tr>
            <tr>
                <td>Computer Networks</td>
                <td>Tanenbaum</td>
                <td>Networking</td>
                <td>19</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary">Edit</button>
                    <button type="button" class="btn btn-sm btn-danger">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>


<!--   Add Book modal               -->
<div class="modal fade" id="addBookModal" tabindex="-1"
     aria-labelledby="addBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-controller="Account" asp-action="AddBook" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addBookModalLabel">Add a New Book</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="book-title" class="form-label">Title</label>
                            <input type="text" class="form-control" id="book-title"
                                   name="Title" required maxlength="200" />
                        </div>
                        <div class="col-md-4">
                            <label for="book-isbn" class="form-label">ISBN</label>
                            <input type="text" class="form-control" id="book-isbn"
                                   name="Isbn" maxlength="20"
                                   placeholder="e.g. 9780132350884" />
                        </div>
                        <div class="col-md-6">
                            <label for="book-author" class="form-label">Author</label>
                            <input type="text" class="form-control" id="book-author"
                                   name="Author" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label for="book-genre" class="form-label">Genre</label>
                            <input type="text" class="form-control" id="book-genre"
                                   name="Genre" required maxlength="50"
                                   placeholder="e.g. Programming, Networking" />
                        </div>
                        <div class="col-md-4">
                            <label for="book-quantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" id="book-quantity"
                                   name="Quantity" required min="0" max="9999" value="1" />
                        </div>
                        <div class="col-md-4">
                            <label for="book-year" class="form-label">Year</label>
                            <input type="number" class="form-control" id="book-year"
                                   name="PublishedYear" min="1000" max="9999"
                                   placeholder="optional" />
                        </div>
                        <div class="col-md-4">
                            <label for="book-publisher" class="form-label">Publisher</label>
                            <input type="text" class="form-control" id="book-publisher"
                                   name="Publisher" maxlength="150"
                                   placeholder="optional" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Book</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(reopen))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('@reopen');
            if (el) new bootstrap.Modal(el).show();
        });
    </script>
}
