@{
    var libName  = "Librarian";
    var libEmail = "lib@lib.org";
    var libPhone = "";
    var libId    = "LIB-0002";

    var reopen = TempData["ReopenModal"] as string;
}

<h2>Account</h2>
<p class="subtitle">Your profile information</p>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["FormError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["FormError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="info-card">
            <div class="info-label">Name</div>
            <div class="info-value">@libName</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="info-card">
            <div class="info-label">Email</div>
            <div class="info-value">@libEmail</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="info-card">
            <div class="info-label">Librarian ID</div>
            <div class="info-value">@libId</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="info-card">
            <div class="info-label">Status</div>
            <div class="info-value text-success">Active</div>
        </div>
    </div>
</div>

<div class="mt-3">
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#editProfileModal">
        Edit Profile
    </button>
    <button type="button" class="btn btn-secondary"
            data-bs-toggle="modal" data-bs-target="#changePasswordModal">
        Change Password
    </button>
</div>


<!--   Edit Profile modal           -->
<div class="modal fade" id="editProfileModal" tabindex="-1"
     aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-controller="Account" asp-action="EditLibrarianProfile" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editProfileModalLabel">Edit Profile</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="lib-edit-name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="lib-edit-name"
                               name="Name" value="@libName" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="lib-edit-email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="lib-edit-email"
                               name="Email" value="@libEmail" required maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label for="lib-edit-phone" class="form-label">Phone (optional)</label>
                        <input type="tel" class="form-control" id="lib-edit-phone"
                               name="Phone" value="@libPhone" maxlength="20" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </div>
        </form>
    </div>
</div>


<!--   Change Password modal        -->
<div class="modal fade" id="changePasswordModal" tabindex="-1"
     aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-controller="Account" asp-action="ChangeLibrarianPassword" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="lib-curr-pw" class="form-label">Current Password</label>
                        <input type="password" class="form-control" id="lib-curr-pw"
                               name="CurrentPassword" required />
                    </div>
                    <div class="mb-3">
                        <label for="lib-new-pw" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="lib-new-pw"
                               name="NewPassword" required minlength="6" />
                        <div class="form-text">At least 6 characters.</div>
                    </div>
                    <div class="mb-3">
                        <label for="lib-confirm-pw" class="form-label">Confirm New Password</label>
                        <input type="password" class="form-control" id="lib-confirm-pw"
                               name="ConfirmPassword" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(reopen))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('@reopen');
            if (el) new bootstrap.Modal(el).show();
        });
    </script>
}
