@model Lib_Mgmt.Models.LibrarianDashboardViewModel

<h2>Dashboard</h2>
<p class="subtitle">Welcome back, Librarian</p>
<hr />

<!-- Stat cards row 1 -->
<div class="row">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-label">Total Titles</div>
            <div class="stat-value">@Model.TotalTitles</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card success">
            <div class="stat-label">Total Members</div>
            <div class="stat-value">@Model.TotalMembers</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card warning">
            <div class="stat-label">Books Borrowed</div>
            <div class="stat-value">@Model.BooksBorrowed</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card danger">
            <div class="stat-label">Overdue</div>
            <div class="stat-value">@Model.OverdueCount</div>
        </div>
    </div>
</div>

<!-- Stat cards row 2 -->
<div class="row mt-2">
    <div class="col-md-4 col-sm-6">
        <div class="stat-card">
            <div class="stat-label">Copies Available</div>
            <div class="stat-value">@Model.CopiesAvailable</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="stat-card warning">
            <div class="stat-label">Total Fines Due</div>
            <div class="stat-value">&#8377;@Model.TotalFinesDue</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="stat-card success">
            <div class="stat-label">New Members This Month</div>
            <div class="stat-value">@Model.NewMembersThisMonth</div>
        </div>
    </div>
</div>

<!-- ── ANALYTICS ───────────────────────────────────────────────── -->
<h4 class="mt-4 mb-3" style="color: var(--accent-text);">Analytics</h4>

<!-- Row 1: Pie + Borrowings bar -->
<div class="row">
    <div class="col-md-4 mb-3">
        <div class="chart-card">
            <div class="chart-title">Book Copy Status</div>
            <canvas id="pieChart"></canvas>
        </div>
    </div>
    <div class="col-md-8 mb-3">
        <div class="chart-card">
            <div class="chart-title">Borrowings — Last 6 Months</div>
            <canvas id="borrowBar"></canvas>
        </div>
    </div>
</div>

<!-- Row 2: Line + Top books bar -->
<div class="row">
    <div class="col-md-6 mb-3">
        <div class="chart-card">
            <div class="chart-title">Fines Collected — Last 6 Months (&#8377;)</div>
            <canvas id="fineLine"></canvas>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="chart-card">
            <div class="chart-title">Top 5 Most Borrowed Books</div>
            <canvas id="topBooksBar"></canvas>
        </div>
    </div>
</div>
<!-- ── END ANALYTICS ───────────────────────────────────────────── -->

<!-- Overdue table -->
<h4 class="mt-2 mb-3" style="color: var(--accent-text);">Overdue Borrowings</h4>
<div class="table-responsive">
    <table class="table table-striped table-hover bg-white">
        <thead class="table-light">
            <tr>
                <th>Member</th>
                <th>Member ID</th>
                <th>Book</th>
                <th>Borrowed On</th>
                <th>Due Date</th>
                <th>Days Overdue</th>
                <th>Fine</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.OverdueBorrowings.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">No overdue borrowings.</td></tr>
            }
            else
            {
                @foreach (var item in Model.OverdueBorrowings)
                {
                    <tr>
                        <td>@item.MemberName</td>
                        <td>@item.MemberId</td>
                        <td>@item.BookTitle</td>
                        <td>@item.BorrowedOn.ToString("dd MMM yyyy")</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td class="text-danger">@item.DaysOverdue</td>
                        <td>&#8377;@item.Fine</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script>
    // Read theme colors from the CSS variables so charts match light/dark mode.
    function themeColor(name) {
        return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }

    Chart.defaults.animation = true;
    Chart.defaults.color = themeColor('--chart-text');

    var charts = [];

    charts.push(new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
            labels: ['Available', 'Borrowed', 'Overdue', 'Damaged'],
            datasets: [{
                data: [@Model.CopiesAvailable, @Model.CopiesBorrowed, @Model.CopiesOverdue, @Model.CopiesDamaged],
                backgroundColor: ['#28a745', themeColor('--chart-blue'), '#ffa726', '#dc3545'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    }));

    charts.push(new Chart(document.getElementById('borrowBar'), {
        type: 'bar',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.BorrowingsPerMonth.Select(m => "'" + m.Month + "'")))],
            datasets: [{
                data: [@string.Join(",", Model.BorrowingsPerMonth.Select(m => m.Count))],
                backgroundColor: themeColor('--chart-blue')
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: themeColor('--chart-grid') } },
                y: { beginAtZero: true, ticks: { stepSize: 5 }, grid: { color: themeColor('--chart-grid') } }
            }
        }
    }));

    charts.push(new Chart(document.getElementById('fineLine'), {
        type: 'line',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.FinesPerMonth.Select(m => "'" + m.Month + "'")))],
            datasets: [{
                data: [@string.Join(",", Model.FinesPerMonth.Select(m => m.Amount))],
                borderColor: '#ffa726',
                backgroundColor: 'rgba(255,167,38,0.12)',
                fill: true,
                tension: 0,
                pointRadius: 4,
                pointBackgroundColor: '#ffa726'
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: themeColor('--chart-grid') } },
                y: { beginAtZero: true, grid: { color: themeColor('--chart-grid') } }
            }
        }
    }));

    charts.push(new Chart(document.getElementById('topBooksBar'), {
        type: 'bar',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.TopBorrowedBooks.Select(b => "'" + b.Title.Replace("'", "\\'") + "'")))],
            datasets: [{
                data: [@string.Join(",", Model.TopBorrowedBooks.Select(b => b.Count))],
                backgroundColor: '#28a745'
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { beginAtZero: true, grid: { color: themeColor('--chart-grid') } },
                y: { grid: { color: themeColor('--chart-grid') } }
            }
        }
    }));

    // Recolour the charts when the user toggles the theme (no page reload needed).
    window.onThemeChange = function () {
        var text = themeColor('--chart-text');
        var grid = themeColor('--chart-grid');
        var blue = themeColor('--chart-blue');
        Chart.defaults.color = text;
        charts.forEach(function (c) {
            // axis tick + grid colours
            if (c.options.scales) {
                Object.keys(c.options.scales).forEach(function (k) {
                    var s = c.options.scales[k];
                    s.ticks = s.ticks || {};
                    s.ticks.color = text;
                    s.grid = s.grid || {};
                    s.grid.color = grid;
                });
            }
            // legend text colour
            if (c.options.plugins && c.options.plugins.legend) {
                c.options.plugins.legend.labels = c.options.plugins.legend.labels || {};
                c.options.plugins.legend.labels.color = text;
            }
            c.update();
        });
        // swap the navy/blue fills (pie 2nd slice + the borrowings bar)
        charts[0].data.datasets[0].backgroundColor[1] = blue;
        charts[1].data.datasets[0].backgroundColor = blue;
        charts[0].update();
        charts[1].update();
    };
</script>
