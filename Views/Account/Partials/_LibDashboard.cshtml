@model Lib_Mgmt.Models.LibrarianDashboardViewModel

<h2>Dashboard</h2>
<p class="subtitle">Welcome back, Librarian</p>
<hr />

<!-- Stat cards row 1 -->
<div class="row" data-reveal-group>
    <div class="col-md-3 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianBooks">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-journals"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Total Titles</div>
                    <div class="stat-value">@Model.TotalTitles</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianMembers">
            <div class="stat-card success">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Total Members</div>
                    <div class="stat-value">@Model.TotalMembers</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianBorrowings">
            <div class="stat-card warning">
                <div class="stat-icon"><i class="bi bi-journal-arrow-up"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Books Borrowed</div>
                    <div class="stat-value">@Model.BooksBorrowed</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianBorrowings">
            <div class="stat-card danger">
                <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Overdue</div>
                    <div class="stat-value">@Model.OverdueCount</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Stat cards row 2 -->
<div class="row mt-2" data-reveal-group>
    <div class="col-md-4 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianBooks">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-stack"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Copies Available</div>
                    <div class="stat-value">@Model.CopiesAvailable</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianBorrowings">
            <div class="stat-card warning">
                <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Total Fines Due</div>
                    <div class="stat-value">&#8377;@Model.TotalFinesDue</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-sm-6" data-reveal>
        <a asp-controller="Account" asp-action="LibrarianMembers">
            <div class="stat-card success">
                <div class="stat-icon"><i class="bi bi-person-plus"></i></div>
                <div class="stat-body">
                    <div class="stat-label">New Members This Month</div>
                    <div class="stat-value">@Model.NewMembersThisMonth</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- ── ANALYTICS ───────────────────────────────────────────────── -->
<h4 class="portal-section-title"><i class="bi bi-graph-up"></i>Analytics</h4>

<!-- Row 1: Pie + Borrowings bar -->
<div class="row">
    <div class="col-md-4 mb-3">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-pie-chart"></i>Book Copy Status</div>
            <canvas id="pieChart"></canvas>
        </div>
    </div>
    <div class="col-md-8 mb-3">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-bar-chart"></i>Borrowings — Last 6 Months</div>
            <canvas id="borrowBar"></canvas>
        </div>
    </div>
</div>

<!-- Row 2: Line + Top books bar -->
<div class="row">
    <div class="col-md-6 mb-3">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-graph-up-arrow"></i>Fines Collected — Last 6 Months (&#8377;)</div>
            <canvas id="fineLine"></canvas>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-trophy"></i>Top 5 Most Borrowed Books</div>
            <canvas id="topBooksBar"></canvas>
        </div>
    </div>
</div>
<!-- ── END ANALYTICS ───────────────────────────────────────────── -->

<!-- Overdue table -->
<h4 class="portal-section-title"><i class="bi bi-exclamation-circle"></i>Overdue Borrowings</h4>
<div class="data-table-wrap">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Member</th>
                <th>Member ID</th>
                <th>Book</th>
                <th>Borrowed On</th>
                <th>Due Date</th>
                <th>Days Overdue</th>
                <th>Fine</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.OverdueBorrowings.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">No overdue borrowings.</td></tr>
            }
            else
            {
                @foreach (var item in Model.OverdueBorrowings)
                {
                    <tr>
                        <td class="fw-semibold">@item.MemberName</td>
                        <td>@item.MemberId</td>
                        <td>@item.BookTitle</td>
                        <td>@item.BorrowedOn.ToString("dd MMM yyyy")</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td><span class="avail-pill no">@item.DaysOverdue days</span></td>
                        <td class="fw-semibold">&#8377;@item.Fine</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script>
    // Read theme colors from CSS variables so charts match light/dark mode.
    function themeColor(name) {
        return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }

    // Explicit defaults so animations + initial colors are not browser-default.
    Chart.defaults.animation = { duration: 800, easing: 'easeOutQuart' };
    Chart.defaults.color = themeColor('--chart-text');

    var charts = [];

    charts.push(new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
            labels: ['Available', 'Borrowed', 'Overdue', 'Damaged'],
            datasets: [{
                data: [@Model.CopiesAvailable, @Model.CopiesBorrowed, @Model.CopiesOverdue, @Model.CopiesDamaged],
                backgroundColor: ['#28a745', themeColor('--chart-blue'), '#ffa726', '#dc3545'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            // Explicit per-chart color (legend + arc labels) so it doesn't
            // depend on Chart.defaults being re-read on theme toggle.
            color: themeColor('--chart-text'),
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { color: themeColor('--chart-text') }
                }
            }
        }
    }));

    charts.push(new Chart(document.getElementById('borrowBar'), {
        type: 'bar',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.BorrowingsPerMonth.Select(m => "'" + m.Month + "'")))],
            datasets: [{
                data: [@string.Join(",", Model.BorrowingsPerMonth.Select(m => m.Count))],
                backgroundColor: themeColor('--chart-blue')
            }]
        },
        options: {
            responsive: true,
            color: themeColor('--chart-text'),
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: themeColor('--chart-text') }, grid: { color: themeColor('--chart-grid') } },
                y: { beginAtZero: true, ticks: { stepSize: 5, color: themeColor('--chart-text') }, grid: { color: themeColor('--chart-grid') } }
            }
        }
    }));

    charts.push(new Chart(document.getElementById('fineLine'), {
        type: 'line',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.FinesPerMonth.Select(m => "'" + m.Month + "'")))],
            datasets: [{
                data: [@string.Join(",", Model.FinesPerMonth.Select(m => m.Amount))],
                borderColor: '#ffa726',
                backgroundColor: 'rgba(255,167,38,0.12)',
                fill: true,
                tension: 0,
                pointRadius: 4,
                pointBackgroundColor: '#ffa726'
            }]
        },
        options: {
            responsive: true,
            color: themeColor('--chart-text'),
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: themeColor('--chart-text') }, grid: { color: themeColor('--chart-grid') } },
                y: { beginAtZero: true, ticks: { color: themeColor('--chart-text') }, grid: { color: themeColor('--chart-grid') } }
            }
        }
    }));

    charts.push(new Chart(document.getElementById('topBooksBar'), {
        type: 'bar',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.TopBorrowedBooks.Select(b => "'" + b.Title.Replace("'", "\\'") + "'")))],
            datasets: [{
                data: [@string.Join(",", Model.TopBorrowedBooks.Select(b => b.Count))],
                backgroundColor: '#28a745'
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            color: themeColor('--chart-text'),
            plugins: { legend: { display: false } },
            scales: {
                x: { beginAtZero: true, ticks: { color: themeColor('--chart-text') }, grid: { color: themeColor('--chart-grid') } },
                y: { ticks: { color: themeColor('--chart-text') }, grid: { color: themeColor('--chart-grid') } }
            }
        }
    }));

    // Recolour the charts when the user toggles the theme (no page reload needed).
    // Sets colors at every level (chart.options.color, scale ticks, scale grid,
    // legend labels) so a Chart.js v3 defaults-merge quirk can't leave a chart
    // showing stale text. update('none') skips the animation on theme toggle
    // so the recolour is instant.
    window.onThemeChange = function () {
        var text = themeColor('--chart-text');
        var grid = themeColor('--chart-grid');
        var blue = themeColor('--chart-blue');
        Chart.defaults.color = text;

        charts.forEach(function (c) {
            c.options.color = text;
            if (c.options.scales) {
                Object.keys(c.options.scales).forEach(function (k) {
                    var s = c.options.scales[k];
                    s.ticks = s.ticks || {}; s.ticks.color = text;
                    s.grid  = s.grid  || {}; s.grid.color  = grid;
                });
            }
            c.options.plugins = c.options.plugins || {};
            c.options.plugins.legend = c.options.plugins.legend || {};
            c.options.plugins.legend.labels = c.options.plugins.legend.labels || {};
            c.options.plugins.legend.labels.color = text;
            c.update('none');
        });

        // Swap the blue fills that came from the --chart-blue CSS var.
        charts[0].data.datasets[0].backgroundColor[1] = blue;
        charts[1].data.datasets[0].backgroundColor    = blue;
        charts[0].update('none');
        charts[1].update('none');
    };
</script>
