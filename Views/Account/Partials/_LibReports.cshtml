<div class="report-cards">
    <div class="report-card">
        <h5><i class="bi bi-bookshelf me-1"></i>Shelf-wise Catalogue</h5>
        <p class="text-secondary small mb-3">Books added, grouped by shelf number.</p>
        <form method="get" asp-action="ExportReport" class="d-flex gap-2">
            <input type="hidden" name="report" value="shelf-catalogue" />
            <input type="hidden" name="format" value="csv" />
            <select name="range" class="form-select form-select-sm report-range-select">
                <option value="month">Last Month</option>
                <option value="year">Last Year</option>
            </select>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-download me-1"></i>Export CSV
            </button>
        </form>
    </div>

    <div class="report-card">
        <h5><i class="bi bi-people me-1"></i>Current Borrowings by Member</h5>
        <p class="text-secondary small mb-3">Active borrowings issued in the selected window.</p>
        <form method="get" asp-action="ExportReport" class="d-flex gap-2">
            <input type="hidden" name="report" value="current-borrowings" />
            <input type="hidden" name="format" value="csv" />
            <select name="range" class="form-select form-select-sm report-range-select">
                <option value="month">Last Month</option>
                <option value="year">Last Year</option>
            </select>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-download me-1"></i>Export CSV
            </button>
        </form>
    </div>
</div>