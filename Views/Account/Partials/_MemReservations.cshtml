@model Lib_Mgmt.Models.MemberReservationsViewModel
@using System.Linq
@{
    var reopen     = TempData["ReopenModal"] as string;
    var formError  = TempData["FormError"] as string;
    var items      = Model?.Items ?? new List<Lib_Mgmt.Models.ReservationItem>();
    var reservable = Model?.ReservableBooks ?? new List<Lib_Mgmt.Models.CatalogBook>();
}

<h2>Reservations</h2>
<p class="subtitle">Books you're waiting on — reserved while every copy was checked out</p>
<hr />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <span class="result-count">@items.Count pending</span>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#reserveBookModal">
        <i class="bi bi-bookmark-plus me-1"></i>Reserve a Book
    </button>
</div>

@if (items.Count == 0)
{
    <div class="empty-state mt-2">
        <i class="bi bi-bookmark-star"></i>
        You have no pending reservations. Use <strong>Reserve a Book</strong> for titles that are
        completely checked out right now.
    </div>
}
else
{
    <div class="data-table-wrap">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th>Requested On</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in items)
                {
                    <tr>
                        <td class="fw-semibold">@r.Title</td>
                        <td>@r.Author</td>
                        <td><span class="genre-badge @Lib_Mgmt.Models.GenreBadge.CssClass(r.Genre)">@r.Genre</span></td>
                        <td>@r.RequestedOn.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal" data-bs-target="#cancelReservationModal"
                                    data-id="@r.Id" data-title="@r.Title">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!--   Reserve a Book modal   -->
<div class="modal fade" id="reserveBookModal" tabindex="-1"
     aria-labelledby="reserveBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Account" asp-action="ReserveBook" method="post">
            <input type="hidden" name="returnTo" value="reservations" />

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reserveBookModalLabel">
                        <i class="bi bi-bookmark-plus"></i>Reserve a Book
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="modal-error" hidden="@(string.IsNullOrEmpty(formError))">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@formError</span>
                    </div>

                    <p class="form-text mb-2">
                        Only books with zero copies on the shelf can be reserved — if a book has copies
                        available, ask a librarian to issue it to you directly instead.
                    </p>

                    <div class="mb-1">
                        <label class="form-label" for="reserve-search">Book</label>
                        <div class="book-typeahead">
                            <input type="text" class="form-control" id="reserve-search"
                                   placeholder="Start typing a title or author…" autocomplete="off" />
                            <div class="book-typeahead-list" id="reserve-search-list" hidden></div>
                        </div>
                        <div class="issue-book-result" id="reserve-search-result"></div>
                    </div>

                    <input type="hidden" id="reserve-book" name="bookId" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="reserve-submit-btn" disabled>Reserve</button>
                </div>
            </div>
        </form>
        @* Only out-of-stock books are offered — same idea as the Issue Book
           modal's catalog data island, just pre-filtered server-side. *@
        <script type="application/json" id="reservable-books-data">
            @{
                var reservableJson = System.Text.Json.JsonSerializer.Serialize(reservable.Select(b => new
                {
                    id = b.Id,
                    title = b.Title,
                    author = b.Author
                })).Replace("</", "<\\/");
            }
            @Html.Raw(reservableJson)
        </script>
    </div>
</div>

<!--   Cancel Reservation confirm modal (filled from data-*)   -->
<div class="modal fade" id="cancelReservationModal" tabindex="-1" data-fillable
     aria-labelledby="cancelReservationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Account" asp-action="CancelReservation" method="post">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelReservationModalLabel">
                        <i class="bi bi-x-circle"></i>Cancel Reservation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" data-field="id" />
                    <input type="hidden" name="title" data-field="title" />
                    <p class="mb-0">
                        Cancel your reservation for <strong data-field="title"></strong>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep it</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancel Reservation
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(reopen))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('@reopen');
            if (el) new bootstrap.Modal(el).show();
        });
    </script>
}
