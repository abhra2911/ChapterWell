@model Lib_Mgmt.Models.MemberBooksViewModel
@{
    var books    = Model?.Books ?? new List<Lib_Mgmt.Models.CatalogBook>();
    var wishSet  = Model?.WishlistedBookIds ?? new HashSet<int>();
    var genres   = books.Select(b => b.Genre)
                        .Where(g => !string.IsNullOrWhiteSpace(g))
                        .Distinct()
                        .OrderBy(g => g)
                        .ToList();
    var byShelf  = books.GroupBy(b => b.ShelfNumber).OrderBy(g => g.Key).ToList();
}

<h2>Books</h2>
<p class="subtitle">Browse the catalog &mdash; filter, search, and tap any book for details</p>
<hr />

<div class="d-flex justify-content-end mb-3">
    <div class="btn-group btn-group-sm" role="group" aria-label="Books view toggle" data-view-toggle>
        <button type="button" class="btn btn-outline-primary active" data-view-btn="list">
            <i class="bi bi-grid me-1"></i>Browse
        </button>
        <button type="button" class="btn btn-outline-primary" data-view-btn="shelf">
            <i class="bi bi-bookshelf me-1"></i>Shelf View
        </button>
    </div>
</div>

<div data-filter-root data-view-pane="list">

    <div class="toolbar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control" data-filter-search
                           placeholder="Search by title, author, or genre..." aria-label="Search books" />
                </div>
            </div>
            <div class="col-lg-7">
                <div class="filter-chips justify-content-lg-end">
                    <span class="chip active" data-filter-avail="all">All</span>
                    <span class="chip" data-filter-avail="available">
                        <i class="bi bi-check-circle me-1"></i>Available only
                    </span>
                </div>
            </div>
        </div>

        <div class="filter-chips mt-3">
            <span class="chip active" data-filter-genre="all">All genres</span>
            @foreach (var g in genres)
            {
                <span class="chip" data-filter-genre="@g.ToLower()">@g</span>
            }
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="result-count" data-filter-count>@books.Count results</span>
    </div>

    <div class="book-grid">
        @foreach (var b in books)
        {
            var cover = $"/images/bookcovers/{b.Isbn}.jpg";
            var saved = wishSet.Contains(b.Id);
            <div class="book-card clickable" data-filter-item
                 data-title="@b.Title" data-author="@b.Author" data-genre="@b.Genre"
                 data-available="@(b.Available ? "true" : "false")">

                <!-- Wishlist toggle (own form, sits above the cover) -->
                <form asp-controller="Account" asp-action="ToggleWishlist" method="post" class="wishlist-form">
                    <input type="hidden" name="bookId" value="@b.Id" />
                    <button type="submit"
                            class="wishlist-toggle @(saved ? "saved" : "")"
                            title="@(saved ? "Remove from wishlist" : "Add to wishlist")"
                            aria-label="@(saved ? "Remove from wishlist" : "Add to wishlist")"
                            aria-pressed="@(saved ? "true" : "false")">
                        <i class="bi @(saved ? "bi-bookmark-fill" : "bi-bookmark")"></i>            @* << WISHLIST BUTTON HERE *@
                    </button>
                </form>

                <!-- Cover + meta — clicking these opens the details modal -->
                <button type="button" class="book-card-trigger"
                        data-bs-toggle="modal" data-bs-target="#bookDetailsModal"
                        data-title="@b.Title" data-author="@b.Author" data-genre="@b.Genre"
                        data-available="@(b.Available ? "true" : "false")"
                        data-isbn="@b.Isbn" data-publisher="@b.Publisher"
                        data-year="@(b.PublishedYear?.ToString() ?? "—")"
                        data-copies="@b.AvailableCopies of @b.Quantity copies"
                        data-shelf="Shelf @b.ShelfNumber"
                        data-cover="@cover">
                    <div class="cover-wrap">
                        <img class="cover" src="@cover" alt="Cover of @b.Title" />
                        <span class="peek"><i class="bi bi-eye"></i>View details</span>
                    </div>
                    <div class="body">
                        <div class="title">@b.Title</div>
                        <div class="author">@b.Author</div>
                        <div class="meta-row">
                            <span class="genre-badge @Lib_Mgmt.Models.GenreBadge.CssClass(b.Genre)">@b.Genre</span>
                            <span class="shelf-pill">Shelf @b.ShelfNumber</span>
                            @if (b.Available)
                            {
                                <span class="avail-pill yes">Available</span>
                            }
                            else
                            {
                                <span class="avail-pill no">Out</span>
                            }
                        </div>
                    </div>
                </button>
            </div>
        }
    </div>

    <div class="empty-state mt-3" data-filter-empty style="display:none">
        <i class="bi bi-journal-x"></i>
        No books match your filters. Try clearing the search or choosing a different genre.
    </div>
</div>


<!--   Book details modal (read-only, filled from the clicked card's data-*)   -->
<div class="modal fade" id="bookDetailsModal" tabindex="-1" data-fillable
     aria-labelledby="bookDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookDetailsModalLabel">
                    <i class="bi bi-book"></i>Book Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-sm-4 text-center">
                        <img class="detail-cover" data-field="cover" src="/images/placeholder-cover.svg" alt="Book cover" />
                        <div class="mt-3">
                            <span class="avail-pill yes" data-avail-pill>Available</span>
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <h4 class="mb-1" style="color: var(--text-primary);" data-field="title"></h4>
                        <p class="text-secondary mb-3" data-field="author"></p>

                        <div class="detail-grid">
                            <div>
                                <div class="detail-label">Genre</div>
                                <div class="detail-value" data-field="genre"></div>
                            </div>
                            <div>
                                <div class="detail-label">Published</div>
                                <div class="detail-value" data-field="year"></div>
                            </div>
                            <div>
                                <div class="detail-label">ISBN</div>
                                <div class="detail-value" data-field="isbn"></div>
                            </div>
                            <div>
                                <div class="detail-label">Publisher</div>
                                <div class="detail-value" data-field="publisher"></div>
                            </div>
                            <div>
                                <div class="detail-label">Shelf</div>
                                <div class="detail-value" data-field="shelf"></div>
                            </div>
                            <div style="grid-column: 1 / -1;">
                                <div class="detail-label">Availability</div>
                                <div class="detail-value" data-field="copies"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!--   Shelf View — books grouped by physical shelf number   -->
<div data-view-pane="shelf" style="display:none">
    @if (byShelf.Count == 0)
    {
        <div class="empty-state mt-3">
            <i class="bi bi-bookshelf"></i>
            No books in the catalog yet.
        </div>
    }
    else
    {
        @foreach (var shelf in byShelf)
        {
            <h4 class="portal-section-title mt-4">
                <i class="bi bi-bookshelf"></i>Shelf @shelf.Key
                <span class="text-secondary small fw-normal">(@shelf.Count() @(shelf.Count() == 1 ? "title" : "titles"))</span>
            </h4>
            <div class="book-grid mb-3">
                @foreach (var b in shelf.OrderBy(x => x.Title))
                {
                    <div class="book-card">
                        <div class="cover-wrap">
                            <img class="cover" src="/images/bookcovers/@(b.Isbn).jpg" alt="Cover of @b.Title" />
                        </div>
                        <div class="body">
                            <div class="title">@b.Title</div>
                            <div class="author">@b.Author</div>
                            <div class="meta-row">
                                <span class="genre-badge @Lib_Mgmt.Models.GenreBadge.CssClass(b.Genre)">@b.Genre</span>
                                @if (b.Available)
                                {
                                    <span class="avail-pill yes">Available</span>
                                }
                                else
                                {
                                    <span class="avail-pill no">Out</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var group = document.querySelector('[data-view-toggle]');
        if (!group) return;
        var buttons = group.querySelectorAll('[data-view-btn]');
        var panes = document.querySelectorAll('[data-view-pane]');
        buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = btn.getAttribute('data-view-btn');
                buttons.forEach(function (b) { b.classList.toggle('active', b === btn); });
                panes.forEach(function (p) {
                    p.style.display = (p.getAttribute('data-view-pane') === target) ? '' : 'none';
                });
            });
        });
    });
</script>
