@using Lib_Mgmt.Models
@{
    ViewData["Title"] = "Member Portal";
    Layout = "_PortalLayout";
    var active = ViewData["ActiveSection"] as string ?? "dashboard";
}

<partial name="Partials/_MemberNav" />

<div class="portal-content">
    @switch (active)
    {
        case "books":
            <partial name="Partials/_MemBooks" model="@(Model as MemberBooksViewModel)" />
            break;
        case "loans":
            <partial name="Partials/_MemLoans" model="@(Model as MemberLoansViewModel)" />
            break;
        case "wishlist":
            <partial name="Partials/_MemWishlist" model="@(Model as MemberWishlistViewModel)" />
            break;
        case "account":
            <partial name="Partials/_MemAccount" />
            break;
        default:
            <partial name="Partials/_MemDashboard" model="@(Model as MemberDashboardViewModel)" />
            break;
    }
</div>

