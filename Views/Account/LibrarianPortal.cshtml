@using Lib_Mgmt.Models
@{
    ViewData["Title"] = "Librarian Portal";
    Layout = "_PortalLayout";
    var active = ViewData["ActiveSection"] as string ?? "lib-dashboard";
}

<partial name="Partials/_LibrarianNav" />

<div class="portal-content">
    @switch (active)
    {
        case "account":
            <partial name="Partials/_LibAccount" />
            break;
        case "books":
            <partial name="Partials/_LibBooks" model="@(Model as LibrarianBooksViewModel)" />
            break;
        case "members":
            <partial name="Partials/_LibMembers" model="@(Model as LibrarianMembersViewModel)" />
            break;
        case "borrowings":
            <partial name="Partials/_LibBorrowings" model="@(Model as LibrarianBorrowingsViewModel)" />
            break;
        case "reports":
            <partial name="Partials/_LibReports" />
            break;
        default:
            <partial name="Partials/_LibDashboard" model="@(Model as LibrarianDashboardViewModel)" />
            break;
    }
</div>
