<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp2.1</TargetFramework>
    <RootNamespace>Lib_Mgmt</RootNamespace>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
    <!-- bcrypt for password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Oracle data access via Devart dotConnect for Oracle.
      EF Core is pinned at 2.1.8 (last 2.1.x). Devart.Data.Oracle.EFCore 9.6.540
      targets EF Core 2.1, so versions are aligned.
      Microsoft.EntityFrameworkCore.Tools is needed in PMC for Scaffold-DbContext.
      Microsoft.VisualStudio.Web.CodeGeneration.Design is for aspnet-codegenerator
      (controllers/views scaffolding); keeping it as you asked.
    -->
    <PackageReference Include="Devart.Data"                                  Version="6.0.190" />
    <PackageReference Include="Devart.Data.Oracle"                           Version="10.4.190" />
    <PackageReference Include="Devart.Data.Oracle.EFCore"                    Version="9.6.540" />
    <PackageReference Include="Microsoft.EntityFrameworkCore"                Version="2.1.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"          Version="2.1.8" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="2.1.9" />
  </ItemGroup>

</Project>
